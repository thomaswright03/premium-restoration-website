{
  // Type check (no build): `npm run typecheck` checks every script in js/
  // (public pages, chat and admin tool) with TypeScript in strict mode,
  // reading the JSDoc in the files. Shared shapes are named in
  // types/globals.d.ts. tests/unit/typecheck.test.js keeps it strict.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": [],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["types/*.d.ts", "js/*.js", "js/admin/*.js", "js/chat/*.js"]
}
