{
  "name": "premium-restoration-website",
  "version": "1.0.0",
  "private": true,
  "description": "Premium Restoration static website (plain HTML/CSS/JS, no build step).",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pages": "node scripts/sync-pages.mjs",
    "check:pages": "node scripts/sync-pages.mjs --check",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run check:pages && npm run check:placeholders && npm run test:unit",
    "test": "npm run check && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "jspdf": "4.2.1",
    "prettier": "3.9.9"
  }
}
