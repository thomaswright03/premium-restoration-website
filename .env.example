# Copy this file to .env.local for local development (Vercel CLI reads it
# automatically). In production, set these as Environment Variables in the
# Vercel project dashboard instead — never commit real values.
#
# Never put these in any file under js/ or any other file the browser loads:
# they must only ever be read by code in /api, which runs on the server.

# Lowe's Developer Hub — Product Catalog capability.
# Fill in once the app registration at developer.lowes.com/portal is approved.
LOWES_API_BASE_URL=
LOWES_API_KEY=
